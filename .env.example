# ==============================================================================
# FinTrack Production Environment Variables (.env.example)
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# NEVER commit your actual .env file or production secrets to Git!
# ==============================================================================

# Server Network Configuration
PORT=5001
HOST=0.0.0.0
NODE_ENV=development
FRONTEND_URL=http://localhost:5001
# For custom domain in production (e.g. https://fintrack.app):
# FRONTEND_URL=https://fintrack.app
# ALLOWED_ORIGINS=https://fintrack.app,https://www.fintrack.app

# Database Configuration (PostgreSQL Target)
# In production on Google Cloud Run, connect to Google Cloud SQL (PostgreSQL), Supabase, or Neon:
# e.g. postgresql://fintrack_user:StrongPassword@/fintrack?host=/cloudsql/project-id:region:instance-name
# e.g. postgresql://fintrack_user:StrongPassword@ep-cool-fog-123456.us-east-2.aws.neon.tech/fintrack?sslmode=require
# If left empty, FinTrack automatically runs on local embedded SQLite for testing.
DATABASE_URL=postgresql://fintrack:fintrack_secret@localhost:5432/fintrack

# Cryptographic & Session Secrets (Generate with `openssl rand -hex 32`)
JWT_SECRET=replace_with_64_character_hex_jwt_secret_token_1234567890abcdef
COOKIE_SECRET=replace_with_64_character_hex_cookie_signature_secret_9876543210

# Server-side AES-256 key used to encrypt BYO API keys stored in the database.
# CRITICAL: Generate a unique random key for each deployment environment.
# Generate with: openssl rand -hex 32
# WARNING: If this is not set or uses the default, BYO API keys are insecure!
SERVER_ENCRYPTION_KEY=replace_with_64_character_hex_server_side_aes_key_12345678abcdef

# Background Job Worker Authentication
# Required by Google Cloud Scheduler to trigger POST /api/jobs/cleanup
CRON_SECRET=replace_with_secure_random_cron_worker_bearer_secret

# Email Verification
# Set to true to require users to verify their email before logging in.
# If false (default), registration succeeds without email verification.
REQUIRE_EMAIL_VERIFICATION=false

# OAuth Authentication: Google Cloud Console
# Create credentials at: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# OAuth Authentication: Apple Developer Account (Apple Sign-In)
# Configure Services ID at: https://developer.apple.com/account/resources/identifiers/list/serviceId
APPLE_CLIENT_ID=app.fintrack.signin
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_KEY_ID=YYYYYYYYYY
# Paste the contents of your downloaded AuthKey_YYYYYYYYYY.p8 in base64 or PEM
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGTAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBHkwdwIBAQQg...\n-----END PRIVATE KEY-----"

# FinTrack Shared AI Assistant (Google Gemini default)
# Get API Key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere1234567890
# Override the default model. Supported: gemini-2.5-flash (default), gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-2.5-flash
